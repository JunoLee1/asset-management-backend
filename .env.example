# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/asset_erp_db"

# Phone Encryption (PHONE_ENCRYPTION_KEY: 64 hex chars = 32 bytes)
PHONE_ENCRYPTION_KEY="your-64-hex-char-key"
PHONE_HASH_SECRET="your-hash-secret"

# Field Encryption — Bank Account & Business Registration
BANK_ACCOUNT_ENCRYPTION_KEY=  # 64 hex chars (32 bytes) for AES-256-CBC
BUSINESS_REG_ENCRYPTION_KEY=  # 64 hex chars (32 bytes) for AES-256-CBC

# Sensitive Audit Log signing
SENSITIVE_LOG_SECRET=          # arbitrary secret for HMAC log signing

# JWT
JWT_SECRET="your-jwt-access-secret"
JWT_REFRESH_SECRET="your-jwt-refresh-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# OAuth - Google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# OAuth - Kakao
KAKAO_CLIENT_ID="your-kakao-client-id"
KAKAO_CLIENT_SECRET="your-kakao-client-secret"
KAKAO_CALLBACK_URL="http://localhost:3001/auth/kakao/callback"

# Email (개발: Ethereal 자동 생성 / 운영: Gmail 앱 비밀번호 필요)
GMAIL_USER="your-gmail@gmail.com"
GMAIL_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"
SMTP_FROM="자산관리 ERP <noreply@company.com>"
FRONTEND_URL="http://localhost:5173"

# Cloudinary (이미지 업로드 — cloudinary.com 가입 후 발급)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Server
PORT=3001
NODE_ENV=development

# libuv threadpool — bcrypt.compare/hash 등 CPU 바운드 async 작업이 여기서 돎 (기본 4)
UV_THREADPOOL_SIZE=8

# Dev Admin 시드 (prisma/seed.ts 가 읽음 — 둘 다 비우면 admin 생성 스킵)
# password 정책: 8자 이상 + 특수문자 1개 이상 (auth zod schema 와 동일)
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""
ADMIN_SEED_NAME="관리자"
